# Copy this file to .env in the same folder (backend/.env) and fill in
# your real values. .env is loaded automatically by database.py.
#
# Option A: one full connection string
# DATABASE_URL=postgresql://sentinel_app:change-me@your-server-host:5432/sentinel_db
#
# Option B: individual parts (used only if DATABASE_URL is unset)
PGHOST=localhost
PGPORT=7000
PGDATABASE=sentinel_db
PGUSER=postgres
PGPASSWORD=Aditya@123
